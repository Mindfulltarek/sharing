# Local development: copy this file to .env.local. Never commit real credentials.
# Production secrets belong in Vercel Project Settings > Environment Variables.

# Neon Postgres pooled or serverless connection string
DATABASE_URL=

# Google OAuth Web client ID; these two values must match.
# Server audience used to verify incoming ID tokens.
GOOGLE_CLIENT_ID=
# Public client ID used by Google Identity Services in the browser build.
VITE_GOOGLE_CLIENT_ID=

# Generate independent random secrets of at least 32 characters.
ACCESS_TOKEN_SECRET=
SHARE_RATE_LIMIT_PEPPER=
CRON_SECRET=

# Private Vercel Blob store. Vercel deployments can use BLOB_STORE_ID + Vercel OIDC.
# For local uploads and storage access, add the store's read-write token locally.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Public key for validating signed Blob upload-completion callbacks.
BLOB_WEBHOOK_PUBLIC_KEY=
# Optional: public base URL for upload callbacks while running outside Vercel.
VERCEL_BLOB_CALLBACK_URL=
