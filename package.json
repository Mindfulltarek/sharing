{
  "name": "sharing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "build": "npm run typecheck && npm run typecheck:api && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "tsx --test server/tests/*.test.ts src/tests/*.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "nitro": "^3.0.260903-beta",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^8.3.4"
  }
}
